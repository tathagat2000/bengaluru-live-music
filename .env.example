# Cloudflare Pages Functions build.
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_WEB_CLIENT_ID.apps.googleusercontent.com

# Server-side Cloudflare environment variables / encrypted secrets:
# GOOGLE_CLIENT_ID = same OAuth client ID
# SPREADSHEET_ID = 1liSjcztKGKxfuFisWGNK23YT_L0oQgq9IOQvZOp7XLc
# GOOGLE_SERVICE_ACCOUNT_JSON = service account JSON with read-only access to the event spreadsheet (secret)
# SESSION_SECRET = 64 random hexadecimal characters (secret)
# PREFERENCES_DB is configured by wrangler.toml; do not set it as a text variable.
