# Choose a deployment mode:
# MODE A — static GitHub Pages, no backend. Enable Google Sheets API + OAuth client.
VITE_CLIENT_SHEETS=true
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_WEB_CLIENT_ID.apps.googleusercontent.com

# MODE B — Cloudflare Pages Functions. Set VITE_CLIENT_SHEETS=false.
# VITE_CLIENT_SHEETS=false
# VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_WEB_CLIENT_ID.apps.googleusercontent.com
# Server-side Cloudflare environment variables / encrypted secrets:
# GOOGLE_CLIENT_ID = same OAuth client ID
# ALLOWED_EMAIL = your Google account email
# SPREADSHEET_ID = 1liSjcztKGKxfuFisWGNK23YT_L0oQgq9IOQvZOp7XLc
# GOOGLE_SERVICE_ACCOUNT_JSON = full JSON service account key (secret)
# SESSION_SECRET = 64 random hexadecimal characters (secret)
