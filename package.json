{
  "name": "bengaluru-live-music",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && tsc -p tsconfig.functions.json && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "deploy": "npm run build && wrangler d1 migrations apply bengaluru-live-preferences --remote --env production --config wrangler.toml && wrangler pages deploy dist --project-name bengaluru-live-music --branch main --config wrangler.toml"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  }
}
